# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ad_tracking

# API
PORT=3001
# Bearer token required for the Public Attribution API (/api/v1/*) only — unrelated
# to logging into the dashboard itself, see JWT_SECRET below.
API_SECRET=change_this_to_a_random_string

# Signs dashboard login sessions (JWT). Every user's clients are scoped to their
# own account - rotating this secret logs everyone out.
JWT_SECRET=change_this_to_a_long_random_string

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdashboard.com

# Facebook Marketing API (ad cost sync) — override if not using the default Graph API version
FB_GRAPH_API_VERSION=v21.0

# Facebook Conversions API (CAPI) and Google Enhanced Conversions are both configured
# per-client via client_integrations (POST /clients/:id/integrations/facebook-capi and
# the conversion_action_* fields on .../integrations/google-ads) — no global env vars.

# Google Ads — shared agency app credentials. Each client's own Google Ads
# account id (customer_id) lives in client_integrations, not here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Bing/Microsoft Advertising — shared app credentials, same pattern as Google Ads.
# Each client's own account_id/customer_id/refresh_token lives in client_integrations.
BING_ADS_DEVELOPER_TOKEN=
BING_ADS_CLIENT_ID=
BING_ADS_CLIENT_SECRET=

# Shopify native app (OAuth install flow, /shopify/install + /shopify/callback) —
# requires a registered app in a Shopify Partner account. Per-shop access tokens are
# stored in client_integrations, not here.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# Step 12 — AI remarketing agent. Used by lib/remarketingAgent.ts to draft outreach
# copy for review; nothing is sent automatically (see routes/remarketing.ts). Per-client
# Customers.ai webhook secret and Klaviyo api_key/list_id live in client_integrations,
# not here.
ANTHROPIC_API_KEY=
